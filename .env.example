# Solace broker (used by solace_agent_mesh_langgraph.A2ALangchainServer)
# Variable names follow the Solace Agent Mesh (SAM) convention so SAM's
# downloaded credentials can be reused unchanged.
SOLACE_BROKER_URL=tcp://localhost:55555
SOLACE_BROKER_VPN=default
SOLACE_BROKER_USERNAME=default
SOLACE_BROKER_PASSWORD=default
SAM_NAMESPACE=sam-demo

# TLS — only needed for tcps:// connections (e.g. Solace Cloud).
# Uncomment SOLACE_BROKER_TRUST_STORE_DIR and point it at a directory of
# PEM/DER CA certificates. On macOS the simplest setup is:
#   pip install certifi
#   mkdir -p ~/.solace-truststore
#   cp "$(python -c 'import certifi; print(certifi.where())')" ~/.solace-truststore/cacert.pem
# Then set the var to ~/.solace-truststore. For Solace Cloud, you can also
# download the cluster's CA bundle from the "Connect" tab and use that dir.
# SOLACE_BROKER_TRUST_STORE_DIR=/Users/you/.solace-truststore

# Dev/testing only — skips cert verification entirely. NEVER set "false" in
# production: it disables TLS protection against MITM.
# SOLACE_BROKER_VALIDATE_CERTS=true

# Example agent (Documentation Formatter)
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# LangSmith tracing (optional)
# Uncomment all four lines below to enable LangSmith tracing for the example
# graph. Picked up automatically by langchain/langgraph when these vars are
# present in the environment — no code changes needed.
# LANGSMITH_TRACING=true
# Custom endpoint if not using LangSmith SaaS
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=<Your Key>
# LANGSMITH_PROJECT=<Your Project>
